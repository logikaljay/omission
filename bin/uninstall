#!/bin/sh
# Stops omission, removes its Hyprland setup (via install.sh --uninstall),
# and removes the package bin/install made.
#
#   bin/uninstall                 everything
#   bin/uninstall --keep-package  only undo the Hyprland setup
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

keep_package=0
for arg in "$@"; do
  case "$arg" in
    --keep-package) keep_package=1 ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "omission: unknown option $arg" >&2; exit 1 ;;
  esac
done

"$ROOT/install.sh" --binary /usr/bin/omission --uninstall

if [ "$keep_package" = 0 ] && pacman -Q omission >/dev/null 2>&1; then
  sudo pacman -Rns --noconfirm omission
  echo "Uninstalled the omission package."
fi
