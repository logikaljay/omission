#!/bin/sh
# Builds omission from source, installs it as an Arch package (so it lands
# in the app launcher), then runs install.sh against that binary to set up
# Hyprland and start it. Options go to install.sh: --yes, --no-hotkeys,
# --no-gestures, --no-autostart.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

"$ROOT/bin/build"
(cd "$ROOT/pkgbuild" && makepkg -fsi --noconfirm)
exec "$ROOT/install.sh" --binary /usr/bin/omission "$@"
